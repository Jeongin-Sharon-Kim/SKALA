cat > .gitignore << 'EOF'
# Python 가상환경
data-project/.venv/
.venv/
venv/

# Python 캐시
__pycache__/
*.pyc

# macOS 시스템 파일
.DS_Store

# Jupyter 임시 파일
.ipynb_checkpoints/
EOF



# macOS
.DS_Store
**/.DS_Store

# IntelliJ
.idea/
**/.idea/
*.iml

# VS Code
.vscode/
**/.vscode/

# Java / Maven
target/
**/target/
*.class

# Logs
*.log